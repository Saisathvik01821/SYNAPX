let currentSubject = null;
let currentTopic = null;

const $ = (selector) => document.querySelector(selector);

function showPage(pageId) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.toggle("active", page.id === pageId);
  });

  window.scrollTo({ top: 0, behavior: "smooth" });
}

function createSubjectCard(subject) {
  return `
    <article class="subject-card" data-subject="${subject.name}">
      <div class="subject-icon">${subject.icon}</div>
      <h3>${subject.name}</h3>
      <p>${subject.description}</p>
      <p style="margin-top:12px;color:var(--green)">
        ${subject.topics.length} starter topics →
      </p>
    </article>
  `;
}

function renderSubjects() {
  const cards = subjects.map(createSubjectCard).join("");

  $("#allSubjects").innerHTML = cards;

  $("#featuredSubjects").innerHTML =
    subjects.slice(0, 4).map(createSubjectCard).join("");

  $("#subjectCount").textContent = subjects.length;
}

function openSubject(subjectName) {
  currentSubject = subjects.find(s => s.name === subjectName);

  if (!currentSubject) return;

  $("#lessonContent").innerHTML = `
    <p class="eyebrow">SUBJECT LEARNING PATH</p>
    <h1>${currentSubject.icon} ${currentSubject.name}</h1>
    <p class="intro">${currentSubject.description}</p>
    <div class="lesson-box">
      <h2>Topics</h2>
      ${currentSubject.topics.map((topic, index) => `
        <button class="quiz-option topic-button" data-topic-index="${index}">
          ${index + 1}. ${topic.title} →
        </button>
      `).join("")}
    </div>
  `;

  showPage("lesson");
}

function openTopic(index) {
  if (!currentSubject) return;

  currentTopic = currentSubject.topics[index];

  if (!currentTopic) return;

  $("#lessonContent").innerHTML = `
    <button class="back-btn" id="backToSubject">
      ← Back to ${currentSubject.name}
    </button>

    <p class="eyebrow">${currentSubject.name.toUpperCase()}</p>
    <h1>${currentTopic.title}</h1>

    <div class="lesson-box">
      <h2>Simple Definition</h2>
      <p>${currentTopic.definition}</p>
    </div>

    <div class="lesson-box">
      <h2>Explanation</h2>
      <p>${currentTopic.theory}</p>
    </div>

    <div class="lesson-box">
      <h2>Example</h2>
      <pre style="white-space:pre-wrap;overflow-wrap:anywhere;color:var(--green)">${currentTopic.example}</pre>
    </div>

    <div class="lesson-box">
      <h2>Real-world Applications</h2>
      <p>${currentTopic.application}</p>
    </div>

    <div class="lesson-box">
      <h2>Common Mistakes</h2>
      <p>${currentTopic.mistakes}</p>
    </div>

    <div class="lesson-box">
      <h2>Quick Knowledge Check</h2>
      <p>What is the main concept of this topic?</p>
      <button class="quiz-option" data-answer="correct">
        Understand the definition and how the concept works
      </button>
      <button class="quiz-option" data-answer="wrong">
        Memorize only the topic name
      </button>
      <div id="topicQuizResult" class="quiz-result"></div>
    </div>
  `;

  $("#backToSubject").addEventListener("click", () => {
    openSubject(currentSubject.name);
  });

  document.querySelectorAll("[data-answer]").forEach(button => {
    button.addEventListener("click", () => {
      const correct = button.dataset.answer === "correct";

      $("#topicQuizResult").textContent = correct
        ? "Correct! Understanding the concept is important."
        : "Try again. Focus on understanding the concept.";

      if (correct) {
        saveProgress(currentSubject.name, currentTopic.title, true);
      } else {
        saveProgress(currentSubject.name, currentTopic.title, false);
      }
    });
  });
}

async function saveProgress(subject, topic, correct) {
  try {
    const response = await fetch("/api/progress", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ subject, topic, correct })
    });

    if (!response.ok) throw new Error("Progress save failed");

    renderProgress();
  } catch (error) {
    console.error(error);
    alert("Could not save progress. Check your backend connection.");
  }
}

async function renderProgress() {
  try {
    const response = await fetch("/api/progress");

    if (!response.ok) throw new Error("Could not load progress");

    const records = await response.json();

    const attempts = records.length;
    const correct = records.filter(item => item.correct === 1).length;

    $("#attemptCount").textContent = attempts;
    $("#correctCount").textContent = correct;

    $("#progressContent").innerHTML = records.length
      ? records.map(item => `
          <div class="progress-item">
            <strong>${item.subject}</strong>
            <p>${item.topic}</p>
            <span style="color:${item.correct ? "var(--green)" : "#e7aa59"}">
              ${item.correct ? "Correct" : "Needs revision"}
            </span>
          </div>
        `).join("")
      : `<p class="empty-state">No learning activity yet. Start a lesson!</p>`;
  } catch (error) {
    $("#progressContent").innerHTML =
      `<p class="empty-state">Progress will appear when the backend is connected.</p>`;
  }
}

function addMessage(message, type) {
  const element = document.createElement("div");
  element.className = `message ${type}`;
  element.textContent = message;

  $("#chatMessages").appendChild(element);
  $("#chatMessages").scrollTop = $("#chatMessages").scrollHeight;

  return element;
}

async function sendMessage(message) {
  addMessage(message, "user");

  const loading = addMessage("BUJJI is thinking...", "bot");

  try {
    const response = await fetch("/api/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "BUJJI could not respond.");
    }

    loading.textContent = data.reply;
  } catch (error) {
    loading.textContent = error.message;
  }
}

$("#chatForm").addEventListener("submit", event => {
  event.preventDefault();

  const input = $("#chatInput");
  const message = input.value.trim();

  if (!message) return;

  input.value = "";
  sendMessage(message);
});

document.addEventListener("click", event => {
  const pageButton = event.target.closest("[data-page]");

  if (pageButton) {
    showPage(pageButton.dataset.page);
  }

  const subjectCard = event.target.closest("[data-subject]");

  if (subjectCard) {
    openSubject(subjectCard.dataset.subject);
  }

  const topicButton = event.target.closest("[data-topic-index]");

  if (topicButton) {
    openTopic(Number(topicButton.dataset.topicIndex));
  }
});

$("#themeBtn").addEventListener("click", () => {
  document.body.classList.toggle("light");

  $("#themeBtn").textContent =
    document.body.classList.contains("light") ? "🌙" : "☀️";
});

renderSubjects();
renderProgress();
