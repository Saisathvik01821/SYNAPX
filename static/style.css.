
:root {
  --bg: #080d12;
  --panel: #101820;
  --panel2: #14212a;
  --text: #e9f2ed;
  --muted: #91a49a;
  --green: #39f58a;
  --border: #23352e;
  --shadow: rgba(0, 0, 0, .25);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Arial, sans-serif;
  min-height: 100vh;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.topbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5%;
  border-bottom: 1px solid var(--border);
  background: var(--panel);
  position: sticky;
  top: 0;
  z-index: 10;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  text-decoration: none;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: 2px;
}

.brand-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #06120a;
  border-radius: 9px;
  font-size: 22px;
}

nav {
  display: flex;
  gap: 12px;
}

nav button,
.theme-btn {
  color: var(--muted);
  background: transparent;
  border: none;
  padding: 10px;
  border-radius: 7px;
}

nav button:hover,
.theme-btn:hover {
  color: var(--green);
  background: var(--panel2);
}

.layout {
  max-width: 1500px;
  margin: auto;
  padding: 35px 5%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 30px;
}

.main-content {
  min-width: 0;
}

.page {
  display: none;
}

.page.active {
  display: block;
}

.eyebrow {
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

h1 {
  font-size: clamp(30px, 5vw, 48px);
  line-height: 1.15;
  margin-bottom: 16px;
}

h1 span {
  color: var(--green);
}

h2 {
  font-size: 21px;
  margin: 32px 0 18px;
}

.intro {
  color: var(--muted);
  max-width: 650px;
  line-height: 1.7;
  margin-bottom: 28px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin: 28px 0;
}

.stat-card,
.subject-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 20px;
  box-shadow: 0 8px 25px var(--shadow);
}

.stat-card span {
  color: var(--muted);
  font-size: 13px;
}

.stat-card strong {
  display: block;
  color: var(--green);
  font-size: 28px;
  margin-top: 10px;
}

.subject-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 15px;
  margin: 20px 0;
}

.subject-card {
  transition: .2s ease;
  cursor: pointer;
}

.subject-card:hover {
  border-color: var(--green);
  transform: translateY(-3px);
}

.subject-icon {
  font-size: 27px;
  margin-bottom: 15px;
}

.subject-card h3 {
  margin-bottom: 9px;
}

.subject-card p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.5;
}

.primary-btn {
  background: var(--green);
  color: #06120a;
  border: none;
  border-radius: 8px;
  padding: 13px 20px;
  font-weight: 800;
  margin-top: 15px;
}

.primary-btn:hover {
  filter: brightness(1.1);
}

.back-btn {
  background: transparent;
  color: var(--green);
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 10px 14px;
  margin-bottom: 25px;
}

.lesson-box {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 22px;
  margin: 15px 0;
  line-height: 1.7;
}

.lesson-box h2,
.lesson-box h3 {
  color: var(--green);
  margin: 0 0 12px;
}

.lesson-box p {
  color: var(--muted);
  margin-bottom: 12px;
}

.lesson-box ul {
  padding-left: 22px;
  color: var(--muted);
}

.quiz-option {
  display: block;
  width: 100%;
  text-align: left;
  background: var(--panel2);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 13px;
  margin: 9px 0;
}

.quiz-option:hover {
  border-color: var(--green);
}

.quiz-result {
  color: var(--green);
  margin-top: 12px;
  font-weight: 700;
}

.bujji-panel {
  height: min(680px, calc(100vh - 120px));
  min-height: 450px;
  position: sticky;
  top: 95px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  display: flex;
  flex-direction: column;
  padding: 18px;
}

.bujji-heading,
.bujji-heading > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.bujji-avatar {
  display: inline-grid;
  place-items: center;
  background: var(--green);
  color: #06120a;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  font-weight: 900;
  margin-right: 7px;
}

.online-dot {
  color: var(--green);
  font-size: 10px;
}

.bujji-description {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
  margin: 15px 0;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px 0;
}

.message {
  max-width: 90%;
  padding: 12px;
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.message.bot {
  background: var(--panel2);
  align-self: flex-start;
}

.message.user {
  background: #123e29;
  align-self: flex-end;
}

.chat-form {
  display: flex;
  gap: 7px;
  border: 1px solid var(--border);
  padding: 6px;
  border-radius: 9px;
}

.chat-form input {
  flex: 1;
  min-width: 0;
  background: transparent;
  color: var(--text);
  border: none;
  outline: none;
  padding: 8px;
}

.chat-form button {
  background: var(--green);
  color: #06120a;
  border: none;
  border-radius: 7px;
  width: 38px;
  font-weight: 900;
}

.small-note {
  color: var(--muted);
  font-size: 10px;
  margin-top: 9px;
}

.progress-item {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 15px;
  margin: 10px 0;
  border-radius: 9px;
}

.empty-state {
  color: var(--muted);
  padding: 20px;
}

body.light {
  --bg: #f1f6f3;
  --panel: #ffffff;
  --panel2: #e6f1e9;
  --text: #14251a;
  --muted: #617268;
  --green: #159b50;
  --border: #d2e2d7;
  --shadow: rgba(20, 50, 30, .07);
}

@media (max-width: 850px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .bujji-panel {
    position: relative;
    top: auto;
    height: 500px;
  }
}

@media (max-width: 550px) {
  .topbar {
    height: auto;
    min-height: 65px;
    padding: 12px 4%;
    flex-wrap: wrap;
    gap: 10px;
  }

  nav {
    order: 3;
    width: 100%;
    justify-content: space-between;
  }

  nav button {
    font-size: 12px;
    padding: 8px 4px;
  }

  .layout {
    padding: 25px 4%;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .stat-card {
    padding: 15px;
  }
}
