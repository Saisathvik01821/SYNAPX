
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080d12">
  <title>SYNAPX | Adaptive Learning</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-icon">S</span>
      <span>SYNAPX</span>
    </a>

    <nav>
      <button data-page="dashboard">Dashboard</button>
      <button data-page="subjects">Explore</button>
      <button data-page="progress">My Progress</button>
    </nav>

    <button id="themeBtn" class="theme-btn">☀️</button>
  </header>

  <main class="layout">
    <section class="main-content">
      <section id="dashboard" class="page active">
        <p class="eyebrow">YOUR LEARNING INTELLIGENCE</p>
        <h1>Understand the Gap.<br><span>Unlock the Mind.</span></h1>
        <p class="intro">
          Learn smarter with personalized learning paths
          and intelligent mistake analysis.
        </p>

        <div class="stats">
          <article class="stat-card">
            <span>Subjects</span>
            <strong id="subjectCount">12</strong>
          </article>
          <article class="stat-card">
            <span>Questions attempted</span>
            <strong id="attemptCount">0</strong>
          </article>
          <article class="stat-card">
            <span>Correct answers</span>
            <strong id="correctCount">0</strong>
          </article>
        </div>

        <h2>Continue learning</h2>
        <div id="featuredSubjects" class="subject-grid"></div>

        <button class="primary-btn" data-page="subjects">
          Explore all subjects →
        </button>
      </section>

      <section id="subjects" class="page">
        <p class="eyebrow">LEARNING LIBRARY</p>
        <h1>Explore subjects</h1>
        <p class="intro">Choose a subject and begin learning.</p>
        <div id="allSubjects" class="subject-grid"></div>
      </section>

      <section id="lesson" class="page">
        <button class="back-btn" data-page="subjects">← Back to subjects</button>
        <div id="lessonContent"></div>
      </section>

      <section id="progress" class="page">
        <p class="eyebrow">YOUR JOURNEY</p>
        <h1>Learning progress</h1>
        <div id="progressContent"></div>
      </section>
    </section>

    <aside class="bujji-panel">
      <div class="bujji-heading">
        <div>
          <span class="bujji-avatar">B</span>
          <strong>BUJJI AI</strong>
        </div>
        <span class="online-dot">● Online interface</span>
      </div>

      <p class="bujji-description">
        Your learning assistant. Ask questions and understand concepts.
      </p>

      <div id="chatMessages" class="chat-messages">
        <div class="message bot">
          Hello! I'm BUJJI. What would you like to learn today?
        </div>
      </div>

      <form id="chatForm" class="chat-form">
        <input
          id="chatInput"
          type="text"
          placeholder="Ask BUJJI anything..."
          maxlength="5000"
          required
        >
        <button type="submit">➤</button>
      </form>
      <p class="small-note">AI responses require backend configuration.</p>
    </aside>
  </main>

  <script src="/static/app.js"></script>
</body>
</html>
